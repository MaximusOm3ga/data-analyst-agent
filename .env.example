KB_VECTOR_STORE=memory
# Use Postgres mode instead of memory:
# KB_VECTOR_STORE=postgres
# KB_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/triage_kb

# Classifier mode:
# - auto: use LLM if API key exists, otherwise heuristic fallback
# - llm: require LLM API call (no fallback)
# - mock: always heuristic fallback
TRIAGE_CLASSIFIER_MODE=auto

# OpenAI-compatible LLM settings (Groq works with this format):
TRIAGE_LLM_BASE_URL=https://api.groq.com/openai/v1
TRIAGE_LLM_MODEL=openai/gpt-oss-120b
# TRIAGE_LLM_API_KEY=your_api_key_here
TRIAGE_LLM_TIMEOUT_SECONDS=45

# Embeddings setup for RAG retrieval quality:
# - auto: use embeddings API if key exists, otherwise mock embeddings
# - api: require real embeddings API
# - mock: always use deterministic mock embeddings
TRIAGE_EMBEDDINGS_MODE=auto
TRIAGE_EMBEDDINGS_BASE_URL=https://api.groq.com/openai/v1
TRIAGE_EMBEDDINGS_MODEL=text-embedding-3-small
# TRIAGE_EMBEDDINGS_API_KEY=your_api_key_here
TRIAGE_EMBEDDINGS_TIMEOUT_SECONDS=45
# Optional: set explicit vector dimension for pgvector schema creation
# KB_EMBEDDING_DIMENSION=1536

# Tool-call execution mode:
# - mock: keep local stubbed actions
# - http: call external HTTP tool endpoints for real execution
TRIAGE_TOOL_CALL_MODE=mock
# TRIAGE_TOOL_HTTP_BASE_URL=http://127.0.0.1:9000
# TRIAGE_TOOL_HTTP_API_KEY=your_tool_api_key_here
TRIAGE_TOOL_HTTP_TIMEOUT_SECONDS=20
TRIAGE_TOOL_HTTP_VERIFY_TLS=true
# Example local tool service for testing:
TRIAGE_TOOL_HTTP_BASE_URL=http://127.0.0.1:9000
# TRIAGE_TOOL_HTTP_ROUTE_PATH=/tools/route
# TRIAGE_TOOL_HTTP_RESOLVE_PATH=/tools/resolve
# TRIAGE_TOOL_HTTP_REVIEW_PATH=/tools/human-review
